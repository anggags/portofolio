# Canonical origin. Used for metadataBase, canonical and og:url.
# Leave unset in development; the site falls back to https://example.com.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Where the contact form is addressed. Also shown in the modal footer and used
# for the Email entry in the menu.
NEXT_PUBLIC_CONTACT_EMAIL=you@example.com

# Social links shown in the menu footer.
NEXT_PUBLIC_SOCIAL_GITHUB=https://github.com/your-handle
NEXT_PUBLIC_SOCIAL_LINKEDIN=https://www.linkedin.com/in/your-handle
